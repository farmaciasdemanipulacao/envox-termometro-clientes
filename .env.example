# ============================================================
# ENVOX Intelligence — Variáveis de Ambiente
# Copie para .env e configure os valores
# NUNCA commite o .env no git
# ============================================================

# === APP ===
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# === BANCO DE DADOS ===
POSTGRES_USER=envox
POSTGRES_PASSWORD=TROQUE_ESSA_SENHA_FORTE_12345
POSTGRES_DB=envox_intel
DATABASE_URL=postgresql+asyncpg://envox:TROQUE_ESSA_SENHA_FORTE_12345@postgres:5432/envox_intel

# Configurações do pool
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Rodar migrations automaticamente no startup (true em dev, cuidado em prod)
AUTO_MIGRATE=true

# === SEGURANÇA ===
# Gere com: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=GERE_UMA_CHAVE_SECRETA_DE_64_CHARS_AQUI_TROQUE_OBRIGATORIO

# Tempo de expiração do JWT (minutos)
ACCESS_TOKEN_EXPIRE_MINUTES=480

# API Key para conectores de ingestão
# Gere uma key aleatória: python3 -c "import secrets; print('envox_' + secrets.token_urlsafe(32))"
API_KEY_SECRET=envox-default-api-key-mude-em-producao

# === CORS ===
# Separe múltiplas origens por vírgula
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# === ADMINISTRADOR PADRÃO ===
ADMIN_USERNAME=admin
ADMIN_PASSWORD=TROQUE_ESSA_SENHA_DO_ADMIN_12345

# === ANÁLISE E ALERTAS ===
DATA_RETENTION_DAYS=90
SUMMARY_SCHEDULE_HOUR=6
SUMMARY_SCHEDULE_MINUTE=0
ALERT_SCAN_INTERVAL_MIN=15
METRICS_UPDATE_INTERVAL_MIN=30

# Thresholds de alerta (0-100)
ALERT_RISK_THRESHOLD=65
ALERT_CRITICAL_THRESHOLD=85
ALERT_OPPORTUNITY_THRESHOLD=60

# Follow-up em atraso após X horas
FOLLOWUP_OVERDUE_HOURS=4

# SLA padrão de resposta (minutos)
SLA_DEFAULT_MINUTES=60

# === IA (OPCIONAL) ===
# Deixe vazio para usar apenas heurísticas (sem custo)
LLM_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_SUMMARY_MAX_TOKENS=500
