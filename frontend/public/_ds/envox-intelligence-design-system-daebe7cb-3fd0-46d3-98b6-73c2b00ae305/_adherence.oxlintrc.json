{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/data/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Inter, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='AlertItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|description|excerpt|severity|alertType|conversationName|timestamp|onAcknowledge|onResolve|key|ref|className|style|children)$/]",
        "message": "<AlertItem> doesn't accept that prop. Declared props: title, description, excerpt, severity, alertType, conversationName, timestamp, onAcknowledge, onResolve."
      },
      {
        "selector": "JSXOpeningElement[name.name='AlertItem'] > JSXAttribute[name.name='severity'] > Literal[value!=/^(?:critical|high|medium|low)$/]",
        "message": "<AlertItem> severity must be one of 'critical' | 'high' | 'medium' | 'low'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|shape|children|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: variant, size, shape, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:critical|high|medium|low|primary|neutral|success|warning|danger)$/]",
        "message": "<Badge> variant must be one of 'critical' | 'high' | 'medium' | 'low' | 'primary' | 'neutral' | 'success' | 'warning' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:xs|sm|md)$/]",
        "message": "<Badge> size must be one of 'xs' | 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='shape'] > Literal[value!=/^(?:pill|rounded)$/]",
        "message": "<Badge> shape must be one of 'pill' | 'rounded'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|icon|iconPosition|disabled|fullWidth|type|children|onClick|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, icon, iconPosition, disabled, fullWidth, type, children, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|danger|success)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'danger' | 'success'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='iconPosition'] > Literal[value!=/^(?:left|right)$/]",
        "message": "<Button> iconPosition must be one of 'left' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit|reset)$/]",
        "message": "<Button> type must be one of 'button' | 'submit' | 'reset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:padding|hover|style|children|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: padding, hover, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='padding'] > Literal[value!=/^(?:none|sm|md|lg)$/]",
        "message": "<Card> padding must be one of 'none' | 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='GroupCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|messageCount|temperatureScore|sentimentLabel|riskScore|opportunityScore|followupsPending|openAlerts|key|ref|className|style|children)$/]",
        "message": "<GroupCard> doesn't accept that prop. Declared props: name, messageCount, temperatureScore, sentimentLabel, riskScore, opportunityScore, followupsPending, openAlerts."
      },
      {
        "selector": "JSXOpeningElement[name.name='GroupCard'] > JSXAttribute[name.name='sentimentLabel'] > Literal[value!=/^(?:positive|negative|critical|neutral)$/]",
        "message": "<GroupCard> sentimentLabel must be one of 'positive' | 'negative' | 'critical' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='KPICard'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|trend|trendUp|colorTheme|key|ref|className|style|children)$/]",
        "message": "<KPICard> doesn't accept that prop. Declared props: label, value, trend, trendUp, colorTheme."
      },
      {
        "selector": "JSXOpeningElement[name.name='KPICard'] > JSXAttribute[name.name='colorTheme'] > Literal[value!=/^(?:default|alert|success|warning|orange)$/]",
        "message": "<KPICard> colorTheme must be one of 'default' | 'alert' | 'success' | 'warning' | 'orange'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
